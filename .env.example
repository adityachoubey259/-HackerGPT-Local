HACKERGPT_ENVIRONMENT=development
HACKERGPT_DEBUG=false
HACKERGPT_API_HOST=127.0.0.1
HACKERGPT_API_PORT=8000
HACKERGPT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HACKERGPT_DATABASE_URL=sqlite+aiosqlite:///./data/databases/hackergpt.db
HACKERGPT_LOG_LEVEL=INFO
HACKERGPT_DATA_DIR=./data
HACKERGPT_DATABASES_DIR=./data/databases
HACKERGPT_UPLOADS_DIR=./data/uploads
HACKERGPT_KNOWLEDGE_DIR=./data/knowledge
HACKERGPT_MODELS_DIR=./data/models
HACKERGPT_NETWORK_ACCESS=false
HACKERGPT_CLOUD_INFERENCE_ENABLED=false
HACKERGPT_MODEL_ENDPOINT_BASE_URL=http://localhost:11434
HACKERGPT_MODEL_ENDPOINT_API_KEY=
HACKERGPT_MODELS_CONFIG_FILE=./config/models.yaml
HACKERGPT_OLLAMA_ENABLED=true
HACKERGPT_OLLAMA_BASE_URL=http://127.0.0.1:11434
HACKERGPT_LLAMA_CPP_ENABLED=false
HACKERGPT_LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
HACKERGPT_OPENAI_COMPATIBLE_ENABLED=false
HACKERGPT_OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8001/v1
HACKERGPT_OPENAI_COMPATIBLE_API_KEY=
HACKERGPT_VLLM_ENABLED=false
HACKERGPT_VLLM_BASE_URL=http://127.0.0.1:8002/v1
HACKERGPT_VLLM_API_KEY=
HACKERGPT_DEFAULT_PROVIDER=ollama
HACKERGPT_DEFAULT_MODEL=
HACKERGPT_SERVE_FRONTEND=true
HACKERGPT_FRONTEND_DIST_DIR=./frontend/dist
